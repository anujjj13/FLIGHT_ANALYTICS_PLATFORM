# Copy this file to `.env` and fill in your real credentials.
# NEVER commit your actual .env file - it's already in .gitignore.

# OpenSky Network API credentials
# Register an API client at: https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Azure Event Hubs (Kafka-compatible endpoint) - producer publishes here
# Use the SEND policy connection string for the producer.
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAMESPACE=
EVENTHUB_NAME=
